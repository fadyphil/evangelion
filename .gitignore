# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Golden-failure artifacts. `matchesGoldenFile` writes a master image, a test
# image, an isolated diff and a masked diff into `failures/` next to the golden
# every time a comparison fails — 64 files and 5.9MB for one Phase-2 run, all of
# it derived from the two images already in the repo. Committed once by accident
# and never read again.
**/failures/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Git worktrees (isolated phase workspaces)
.worktrees/

# Local environment / secrets — never commit
.env
.env.*
!.env.example

# Design prototype (eva/) is a React reference; keep source, drop its toolchain output
eva/node_modules/
eva/dist/
eva/.figma/design-context/
eva/.plugins/
eva/.opencode-skills/
