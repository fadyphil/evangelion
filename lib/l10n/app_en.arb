  "homeCategoryProphets": "prophets",
  "@homeCategoryProphets": {
    "description": "A book card's caption category. Transcribed: `redesign.html:1036` — `CATS.prophets`. See `homeCategoryPoetry` for why the six categories are ARB keys and not a field."
