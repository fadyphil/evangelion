<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Cleartext HTTP is allowed in DEBUG builds only, and the attribute
         lives HERE rather than in `src/main` because the deployed backend is
         served over TLS (ADR-0023).

         The local backend is still plain HTTP at http://localhost:3000, and
         since API 28 cleartext traffic defaults to false once targetSdk >= 28
         (here targetSdk = flutter.targetSdkVersion, see build.gradle.kts), a
         debug build without this attribute fails at the first request with
         `SocketException: Cleartext HTTP traffic to localhost not permitted`.

         Android grants NO localhost exemption, so the exemption has to be
         asked for explicitly — and it is asked for in the two build types
         that develop against a plaintext host, and in neither of the others.
         `src/main` no longer declares it, so a RELEASE build is TLS-only.

         This element merges with `src/main`'s `<application>`: the attribute
         is declared in one manifest and absent from the other, so the merger
         adds it rather than resolving a conflict, and no `tools:replace` is
         needed. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
