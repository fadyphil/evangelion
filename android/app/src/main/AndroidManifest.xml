<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Release builds talk to the Evangelion API over HTTP. The debug/profile
         manifests already declare this, so without it here every network call
         fails in release only. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- `android:usesCleartextTraffic="true"` is NOT HERE, and its absence is
         the point.

         It WAS here, and the comment that stood in this place said what to do
         with it: "REMOVE this attribute once the backend is served over TLS —
         it must never ship to production." The backend IS served over TLS now
         (`https://evangelion-backend.vercel.app`, ADR-0023), so the release
         build talks HTTPS and needs no exemption. Since API 28 cleartext
         traffic defaults to false once targetSdk >= 28 (here targetSdk =
         flutter.targetSdkVersion, see build.gradle.kts), the ABSENCE of the
         attribute is what blocks it.

         The two development build types carry the attribute themselves — see
         `android/app/src/debug/AndroidManifest.xml` and
         `.../profile/AndroidManifest.xml` — because the local backend is
         still plain HTTP. Release does not. -->
    <application
        android:label="evangelion"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
